# htdocs/uploads/.htaccess — BLOCK SCRIPT EXECUTION
# Prevent PHP, shell, and other scripts from running inside uploads

<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi|exe)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Also block if mod_php is loaded
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Force download for certain file types
<FilesMatch "\.(pdf)$">
    ForceType application/octet-stream
</FilesMatch>

# Disable directory listing
Options -Indexes